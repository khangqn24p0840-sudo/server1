# File .env chi nam tren may cua ban, khong gui len GitHub va khong gui cho nguoi khac.
# ADMIN_KEY: thay chuoi mau bang mot khoa rieng, dai va kho doan.
ADMIN_KEY=doi-thanh-chuoi-bi-mat-dai
# GEMINI_API_KEY: Google AI Studio key. Keep it private; never commit the real .env file.
# If empty, text analysis uses local rules and Gemini features return a configuration error.
GEMINI_API_KEY=
# Flash model used for chat, text scans, and tracked-conversation context analysis.
GEMINI_MODEL=gemini-3.5-flash-lite
# Lightweight stable fallback for temporary overload/timeouts (supports text and image input).
GEMINI_FALLBACK_MODEL=gemini-3.8-flash

# VietQR (tùy chọn): để trống thì server vẫn hiển thị danh sách ngân hàng,
# nhưng tính năng tra tên chủ tài khoản sẽ báo chưa cấu hình.
# Lấy credentials từ tài khoản VietQR của dự án; không đưa vào APK/GitHub.
VIETQR_CLIENT_ID=
VIETQR_API_KEY=
# false = đóng đăng ký sau khi bạn đã tạo tài khoản của mình
ALLOW_REGISTRATION=true
# Khóa ký đăng nhập; bỏ trống sẽ tự sinh và lưu trong data/secret.key
SECRET_KEY=

# Tin báo chí (RSS): tự tải mỗi N phút, giữ N ngày. NEWS_ENABLED=false để tắt.
NEWS_ENABLED=true
NEWS_INTERVAL_MIN=30
NEWS_KEEP_DAYS=60

# Keep admin endpoints inaccessible through public tunnels by default.
ADMIN_LOCAL_ONLY=true
TRUST_PROXY=true